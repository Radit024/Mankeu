<?xml version="1.0" encoding="utf-8"?>
<!--
  Wraps the Arina Agri brand mark (ic_arina_logo, 8669.86x8669.86 viewBox) with a safe-zone inset.
  Android's adaptive icon masks the outer margin with circles or rounded squircles (~66% safe area),
  so an inset keeps the leaf and circuit-board branches safely inside the mask.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_arina_logo"
    android:insetLeft="20%"
    android:insetTop="20%"
    android:insetRight="20%"
    android:insetBottom="20%" />
