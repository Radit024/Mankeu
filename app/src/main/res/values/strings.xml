    <!-- Tier 2 Contextual Page Tours -->
    <string name="tour_settings_drive_title">Sinkronisasi Cloud dan Google Drive</string>
    <string name="tour_settings_drive_desc">Hubungkan akun Google untuk mencadangkan pembukuan ke folder privat Google Drive (drive.appdata) secara aman. Tidak ada server pihak ketiga — cadangan ada sepenuhnya di Google Drive pribadi Anda, dalam folder tersembunyi yang hanya bisa diakses aplikasi ini.</string>
    <string name="tour_settings_security_title">Enkripsi AES-256-GCM dan Reset</string>
    <string name="tour_settings_security_desc">Semua cadangan dienkripsi dengan kata sandi Anda menggunakan AES-256-GCM. Tanpa kata sandi ini, cadangan tidak bisa dibuka — bahkan oleh pengembang aplikasi. Simpan kata sandi di tempat yang aman. Data lokal juga dapat diatur ulang sewaktu-waktu.</string>

    <string name="tour_scope_business_title">Tambah dan Kelola Usaha</string>
    <string name="tour_scope_business_desc">Buat unit usaha baru — misalnya satu usaha \"Toko Sembako Berkah\", satu usaha \"Kopi Kenangan Senja\", atau \"Bengkel Servis Jaya\". Setiap usaha memiliki master kategori, satuan, dan cabang/unit sendiri yang tidak saling bercampur.</string>
    <string name="tour_scope_field_title">Cabang, Outlet dan Proyek</string>
    <string name="tour_scope_field_desc">Tambahkan cabang toko, gerai outlet, atau proyek usaha tertentu beserta tanggal periode operasionalnya. Setiap unit usaha memiliki pembukuan dan analisis kelayakan tersendiri.</string>

    <string name="tour_import_picker_title">Pilih File Excel (.xlsx)</string>
    <string name="tour_import_picker_desc">Unduh template Mankeu lewat Ekspor, isi di Excel, lalu pilih filenya di sini. Hanya template Mankeu yang bisa diimpor; isinya ditambahkan ke unit usaha yang sedang dipilih setelah kamu meninjau pratinjaunya.</string>

    <string name="tour_reports_cashflow_title">Arus Kas Operasional</string>
    <string name="tour_reports_cashflow_desc">Arus kas menunjukkan uang yang benar-benar masuk dan keluar. Kas Operasi mencatat aktivitas jual-beli harian; Kas Investasi mencatat pembelian peralatan dan aset; Kas Pembiayaan mencatat setoran modal dan pengambilan pribadi (prive).</string>
    <string name="tour_data_export_title">Ekspor dan Cadangan Data</string>
    <string name="tour_data_export_desc">Ekspor catatan ke file Excel (.xlsx) atau laporan PDF untuk arsip cetak. Cadangan lokal terenkripsi AES-256-GCM bisa disimpan ke penyimpanan ponsel, dan cadangan cloud ke Google Drive pribadi. Lakukan pencadangan rutin — terutama sebelum ganti ponsel atau tutup buku periode.</string>
    <string name="tour_settings_display_title">Tampilan dan Bahasa</string>
    <string name="tour_settings_display_desc">Ganti tema Terang, Gelap, atau ikut Sistem. Pilih bahasa Indonesia atau Inggris. Atur kecepatan animasi: Penuh untuk transisi mulus, Dikurangi untuk perangkat lambat. Getar dan suara ketuk juga bisa dimatikan di sini.</string>
    <string name="about_desc">Mankeu adalah aplikasi manajemen keuangan dan pencatatan kas UMKM offline-first. Dirancang untuk membantu pelaku usaha mikro, kecil, dan menengah mencatat transaksi harian, menyusun anggaran (RAB), menghitung titik impas (BEP), HPP, margin laba, dan kebutuhan modal kerja tanpa tergantung koneksi internet.</string>
    <string name="about_version">Versi %s</string>

