    <!-- Tier 2 Contextual Page Tours -->
    <string name="tour_settings_drive_title">Cloud Sync and Google Drive</string>
    <string name="tour_settings_drive_desc">Connect your Google Account to back up business records into private Google Drive storage (drive.appdata) securely. There is no third-party server — backups live entirely in your own Google Drive, in a hidden folder that only this app can access.</string>
    <string name="tour_settings_security_title">AES-256-GCM Encryption and Reset</string>
    <string name="tour_settings_security_desc">All backups are encrypted with your custom passphrase using AES-256-GCM. Without this passphrase, backups cannot be opened — not even by the app developer. Keep it somewhere safe. The local database can also be reset at any time.</string>

    <string name="tour_scope_business_title">Add and Manage Business Ventures</string>
    <string name="tour_scope_business_desc">Create separate business units — for example one called \"Grocery Store\", another \"Coffee Shop\", another \"Repair Workshop\". Each business has its own categories, units, and branches that never mix.</string>
    <string name="tour_scope_field_title">Branches, Outlets and Projects</string>
    <string name="tour_scope_field_desc">Register specific branches, outlets, or projects with their operational timeframes. Each unit has its own ledger. Feasibility reports (BEP, HPP) are calculated per unit.</string>

    <string name="tour_import_picker_title">Select Excel Workbook (.xlsx)</string>
    <string name="tour_import_picker_desc">Download the Mankeu template from Export, fill it in Excel, then pick the file here. Only the Mankeu template can be imported; its contents are added to the selected business unit after you review the preview.</string>

    <string name="tour_reports_cashflow_title">Operating Cash Flow</string>
    <string name="tour_reports_cashflow_desc">Cash flow shows money that actually came in and went out. Operating cash covers daily buying and selling; investing cash covers equipment and asset purchases; financing cash covers owner capital and owner drawings.</string>
    <string name="tour_data_export_title">Export and Backup</string>
    <string name="tour_data_export_desc">Export records to an Excel workbook (.xlsx) or a PDF report for print archiving. AES-256-GCM encrypted local backups can be saved to phone storage, and cloud backups to your private Google Drive. Back up regularly — especially before switching phones or closing accounting periods.</string>
    <string name="tour_settings_display_title">Display and Language</string>
    <string name="tour_settings_display_desc">Switch between Light, Dark, or System theme. Choose Indonesian or English. Adjust animation speed: Full for smooth transitions, Reduced for slower devices. Haptic feedback and tap sounds can also be toggled here.</string>

    <string name="about_desc">Mankeu is an offline-first financial management and bookkeeping app for micro, small, and medium enterprises (MSMEs). It helps shop owners, food stalls, restaurants, and service providers record transactions, build a projected budget, and calculate break-even (BEP), unit cost (HPP), profit margins, and working capital without an internet connection.</string>
